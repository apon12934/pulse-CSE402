// ─────────────────────────────────────────────────────────────
//  Pulse — Prisma Schema
//  Database: TiDB Serverless (MySQL-compatible)
//  ORM:      Prisma
// ─────────────────────────────────────────────────────────────

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────

/// Distinguishes immovable events (Anchor) from flexible tasks (Fluid).
enum TaskType {
  Anchor
  Fluid
}

/// Lifecycle status of a scheduled task.
enum TaskStatus {
  Upcoming
  Running
  Completed
  Overdue
}

/// User-reported energy state for AI scheduling optimization.
enum EnergyLevel {
  High
  Medium
  Low
}

/// Account tier for future feature gating.
enum UserTier {
  Free
  Pro
}

// ─── Models ───────────────────────────────────────────────────

/// Core user account — isolated, multi-tenant environment.
model User {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(100)
  email     String   @unique @db.VarChar(255)
  username  String?  @unique @db.VarChar(50)
  password  String   @db.VarChar(255)
  tier               UserTier @default(Free)
  geminiApiKey       String?  @map("gemini_api_key")
  avatarUrl          String?  @map("avatar_url")
  rescheduleStrategy String   @default("BALANCED") @map("reschedule_strategy")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  // Relations
  tasks         Task[]
  taskBlocks    TaskBlock[]
  dailyRoutines DailyRoutine[]
  templateTasks TemplateTask[]
  chatMessages  ChatMessage[]

  @@map("users")
}

/// A single schedulable unit — either an Anchor (fixed) or Fluid (flexible).
model Task {
  id          String      @id @default(cuid())
  userId      String      @map("user_id")
  title       String      @db.VarChar(255)
  description String?     @db.Text
  type        TaskType
  status      TaskStatus  @default(Upcoming)
  energyLevel EnergyLevel @default(Medium) @map("energy_level")
  priority    Int         @default(0)
  startTime   DateTime    @map("start_time")
  endTime     DateTime    @map("end_time")
  taskBlockId    String?     @map("task_block_id")
  templateTaskId String?     @map("template_task_id")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  // Relations
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskBlock TaskBlock? @relation(fields: [taskBlockId], references: [id], onDelete: SetNull)
  templateTask TemplateTask? @relation(fields: [templateTaskId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, status])
  @@index([userId, startTime])
  @@index([taskBlockId])
  @@index([templateTaskId])
  @@map("tasks")
}

/// Composite grouping of tasks — supports the Composite pattern
/// for organizing related tasks under named blocks.
model TaskBlock {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  blockName   String   @map("block_name") @db.VarChar(255)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([userId])
  @@map("task_blocks")
}

/// Daily aggregate snapshot — tracks Anchor/Fluid distribution
/// and completion metrics for a user's day.
model DailyRoutine {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  date           DateTime @db.Date
  totalAnchors   Int      @default(0) @map("total_anchors")
  totalFluid     Int      @default(0) @map("total_fluid")
  completedTasks Int      @default(0) @map("completed_tasks")
  skippedTasks   Int      @default(0) @map("skipped_tasks")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@map("daily_routines")
}

/// Defines a recurring weekly task — the template that generates Task instances each week.
model TemplateTask {
  id          String      @id @default(cuid())
  userId      String      @map("user_id")
  title       String      @db.VarChar(255)
  type        TaskType
  energyLevel EnergyLevel @default(Medium) @map("energy_level")
  priority    Int         @default(0)
  dayOfWeek   Int         @map("day_of_week")
  startHour   Int         @map("start_hour")
  startMinute Int         @default(0) @map("start_minute")
  endHour     Int         @map("end_hour")
  endMinute   Int         @default(0) @map("end_minute")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([userId])
  @@index([userId, dayOfWeek])
  @@map("template_tasks")
}

/// Stores AI chat history for the user.
model ChatMessage {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  role      String   @db.VarChar(50) // "user" | "model"
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("chat_messages")
}
