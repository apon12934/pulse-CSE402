# ─── TiDB Serverless Connection ───────────────────────────
# Replace with your actual TiDB Serverless connection string.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE?sslaccept=strict
DATABASE_URL="mysql://user:password@gateway01.region.prod.aws.tidbcloud.com:4000/pulse?sslaccept=strict"

# ─── Authentication ───────────────────────────────────────
# A strong random secret for signing JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="change-me-to-a-random-64-byte-hex-string"

# ─── Server ───────────────────────────────────────────────
PORT=4000

# ─── Gemini AI ────────────────────────────────────────────
# Get your API key from https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key"
